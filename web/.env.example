# web/.env.local 템플릿. 이 파일을 .env.local 로 복사해서 값을 채운다.
#   cp web/.env.example web/.env.local
#
# NEXT_PUBLIC_* 은 빌드 시점에 JS 번들로 컴파일돼 브라우저에 그대로 노출된다.
# 비밀이 아닌 값만 넣는다 — 비밀은 backend/.env 로.
#
# 같은 값들이 GitHub Actions secrets 에도 등록돼 있어야 한다. CI 가 web 이미지를
# 빌드할 때 여기 값을 모르면 빈 문자열로 박히고, 워크플로는 성공했는데 앱만
# Supabase 를 못 찾아 죽는다.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon public 키. 공개돼도 되는 전제이며, 실제 보호는 Supabase RLS 가 한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kakao Developers JavaScript 키. 콘솔에서 도메인 제한을 걸어둔다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- 아래는 보통 비워둔다 ---
#
# 브라우저는 항상 동일 오리진 /api/* 를 호출한다. 운영에서는 nginx 가, 로컬
# dev 에서는 next.config.ts 의 rewrite 가 FastAPI 로 넘긴다. 그래서 브라우저용
# API 주소를 여기 둘 필요가 없다.
#
# dev 에서 백엔드를 8001 이 아닌 곳에 띄웠을 때만 지정:
# DEV_API_PROXY=http://localhost:8001
#
# INTERNAL_API_BASE 는 운영 컨테이너의 SSR 이 백엔드로 직접 호출할 때 쓰며,
# docker-compose.yml 이 http://backend:8001 로 넣어준다. 로컬에서는 불필요.
#
# 우리 테이블이 사는 스키마 이름. 비우면 pmis. 팀 공용 프로젝트에서는
# site_info 를 넣고, backend/.env 의 DB_SCHEMA 와 값을 일치시킨다.
# NEXT_PUBLIC_DB_SCHEMA=site_info
#
# 세션 토큰(우리가 발급) 검증용 서명키. proxy.ts 가 서버에서만 쓴다.
# backend/.env 의 APP_JWT_SECRET 과 **같은 값**이어야 하고,
# NEXT_PUBLIC_ 을 붙이면 브라우저로 새어 토큰 위조가 가능해진다.
APP_JWT_SECRET=
