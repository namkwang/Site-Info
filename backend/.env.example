# backend/.env 템플릿. 이 파일을 .env 로 복사해서 값을 채운다.
#   cp backend/.env.example backend/.env
#
# 실제 .env 는 절대 커밋하지 않는다 (.gitignore 처리됨).
# 운영 서버에서는 docker-compose 가 이 파일을 backend 컨테이너에 주입한다.

# Supabase 프로젝트 URL. JWT 검증(issuer/JWKS)에도 쓰이므로 정확해야 한다.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role 키 — RLS 를 우회하는 전권 키다. 절대 프론트로 넘기지 말 것.
# (프론트가 쓰는 건 web 쪽 anon 키다.)
SUPABASE_SERVICE_ROLE_KEY=

# Kakao Developers REST API 키. 주소 지오코딩에 사용.
# 프론트의 NEXT_PUBLIC_KAKAO_JS_KEY 와는 다른 키다.
KAKAO_REST_KEY=

# Postgres 직결 문자열. 앱 런타임에는 안 쓰이고
# scripts/apply_migration.py 로 마이그레이션 돌릴 때만 필요하다.
DATABASE_URL=

# 우리 테이블이 사는 스키마 이름. 비우면 pmis (개인 개발 프로젝트).
# 팀 공용 프로젝트에서는 site_info 를 넣는다 — 코드에 스키마 이름을 박지
# 않았으므로(supabase_client.db()) 이 값만 바꾸면 전환된다.
# web/.env.local 의 NEXT_PUBLIC_DB_SCHEMA 와 반드시 같은 값이어야 한다.
DB_SCHEMA=

# 우리가 발급하는 세션 토큰의 서명키 (HS256, 32자 이상).
# 로그인·비밀번호 검증을 Supabase Auth 대신 우리가 하므로 필수다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 값을 바꾸면 발급된 모든 세션이 무효가 되어 전원 재로그인해야 한다.
APP_JWT_SECRET=

# 그룹 포털 SSO 연동용 공유 토큰. 포털의 HANDOFF_EXTERNAL_TOKEN 과
# 같은 값이어야 한다. 포털이 티켓 발급 API 를 부를 때 X-External-Token
# 헤더로 보내며, 이 값이 곧 포털을 인증하는 수단이다.
EXTERNAL_SSO_TOKEN=
